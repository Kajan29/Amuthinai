# =============================================================================
# Render Environment Variables — copy these into
# Render Dashboard → Web Service → Environment → Add Environment Variable
# =============================================================================
# Do NOT commit real secrets. Replace every REPLACE_ME / your-* value.
# Do NOT set PORT — Render injects it automatically.

# --- App ---
NODE_ENV=production
NODE_VERSION=20

# --- MongoDB Atlas (required) ---
# Atlas → Database → Connect → Drivers → copy the SRV string.
# Replace <password> and set the DB name to amuthinai.
# Atlas → Network Access → add 0.0.0.0/0 (Render IPs change).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/amuthinai?retryWrites=true&w=majority
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# --- JWT (required, min 16 chars each) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=REPLACE_ME_GENERATE_ANOTHER_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
# Mobile app does not need browser CORS. Keep * unless you also host a web client.
CORS_ORIGINS=*

# --- Uploads ---
# Joi only allows local | s3. Cloudinary still works when CLOUDINARY_* is set.
# Do NOT set UPLOAD_DRIVER=cloudinary — the API will fail to boot.
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=https://YOUR-SERVICE-NAME.onrender.com

# --- Cloudinary (required on Render — disk is wiped on every deploy) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=amuthinai

# --- Freshness cron ---
DEFAULT_SAFE_HOURS=6
FRESHNESS_CRON=0 */15 * * * *

# --- Google OAuth (optional — skip if you only use email/password) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://YOUR-SERVICE-NAME.onrender.com/api/v1/auth/google/callback

# --- SMTP / OTP email (required for register + password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=Amuthinai <your-email@gmail.com>
OTP_EXPIRES_IN=10m
OTP_LENGTH=6
