{
  "expo": {
    "name": "Amuthinai",
    "slug": "amuthinai",
    "owner": "kajan2906",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "amuthinai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.amuthinai.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Amuthinai uses your location to show nearby donations and pickups.",
        "NSCameraUsageDescription": "Amuthinai uses the camera to capture pickup and delivery proof photos.",
        "NSPhotoLibraryUsageDescription": "Amuthinai needs photo access to attach food images to a donation."
      }
    },
    "android": {
      "package": "lk.amuthinai.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Amuthinai uses your location to match you with nearby pickups."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Amuthinai needs photo access to attach food images to a donation.",
          "cameraPermission": "Amuthinai uses the camera to capture pickup and delivery proof photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0F7B4F"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21cde7c3-357b-4588-839c-80025bd24b92"
      }
    }
  }
}
