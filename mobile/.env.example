# Only EXPO_PUBLIC_* variables are readable from app code — never put secrets here.
# Use your machine's LAN IP (not localhost) when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Same Google Web Client ID as backend GOOGLE_CLIENT_ID (ID token verification)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Unused — Android maps now render through Mapbox, not Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mapbox Configuration
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
MAPBOX_DOWNLOADS_TOKEN=sk.your_mapbox_secret_token_here

# Cloudinary Configuration (for client-side uploads)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=amuthinai_unsigned
