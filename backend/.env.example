NODE_ENV=development
PORT=3000

# MongoDB — matches the service in the repository root docker-compose.yml
MONGODB_URI=mongodb://localhost:27017/amuthinai

# Replace both secrets before any deployment.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Local disk is the default image store; point this at S3-compatible storage in production.
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000

# FR3 — default safe-consumption window and how often the freshness cron runs.
DEFAULT_SAFE_HOURS=6
FRESHNESS_CRON=0 */15 * * * *
