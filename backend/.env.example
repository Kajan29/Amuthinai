NODE_ENV=development
PORT=3000

# MongoDB — matches the service in the repository root docker-compose.yml
MONGODB_URI=mongodb://localhost:27017/amuthinai

# Replace both secrets before any deployment.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Local disk is the default image store; point this at S3-compatible storage in production.
UPLOAD_DRIVER=cloudinary
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=amuthinai

# FR3 — default safe-consumption window and how often the freshness cron runs.
DEFAULT_SAFE_HOURS=6
FRESHNESS_CRON=0 */15 * * * *

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=Amuthinai <noreply@amuthinai.com>

# OTP Configuration
OTP_EXPIRES_IN=10m
OTP_LENGTH=6
